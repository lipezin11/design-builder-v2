{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-builder.local/schemas/delta_fix_plan.schema.json",
  "title": "Delta Fix Plan",
  "description": "Surgical correction contract that routes each critic issue to the shallowest responsible pipeline layer while protecting unaffected decisions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "delta_fix_plan_id", "project_id", "run_id", "critic_report_ref", "generation_result_ref", "final_frame_spec_ref", "status", "strategy", "return_depth", "responsible_nodes", "fixes", "global_protections", "execution_constraints", "validation_plan", "human_approval", "provenance"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "delta_fix_plan_id": { "$ref": "#/$defs/id" },
    "project_id": { "$ref": "#/$defs/id" },
    "run_id": { "$ref": "#/$defs/id" },
    "critic_report_ref": { "$ref": "#/$defs/artifact_ref" },
    "generation_result_ref": { "$ref": "#/$defs/artifact_ref" },
    "final_frame_spec_ref": { "$ref": "#/$defs/artifact_ref" },
    "status": { "enum": ["READY", "HUMAN_REVIEW_REQUIRED", "BLOCKED", "APPLIED", "SUPERSEDED"] },
    "strategy": { "const": "SURGICAL_DELTA" },
    "return_depth": { "$ref": "#/$defs/return_depth" },
    "responsible_nodes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/responsible_node" } },
    "fixes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fix" } },
    "global_protections": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/field_protection" } },
    "execution_constraints": { "$ref": "#/$defs/execution_constraints" },
    "validation_plan": { "$ref": "#/$defs/validation_plan" },
    "human_approval": { "$ref": "#/$defs/human_approval" },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$" },
    "json_pointer": { "type": "string", "pattern": "^(/([^~/]|~[01])*)*$" },
    "artifact_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "artifact_version"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/id" },
        "artifact_version": { "type": "string", "minLength": 1 },
        "artifact_uri": { "type": "string", "minLength": 1 },
        "checksum": { "type": "string", "minLength": 1 }
      }
    },
    "severity": { "enum": ["INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "return_depth": { "enum": ["GENERATION_ONLY", "GENERATOR_COMPILER", "TECHNICAL_DESIGN_ROOM", "CREATIVE_DIRECTION_ROOM", "REFERENCE_TRANSLATOR"] },
    "responsible_node": { "enum": ["IMAGE_GENERATOR", "GENERATOR_COMPILER", "VISUAL_SYSTEMS", "LAYOUT_TYPOGRAPHY", "TECHNICAL_DESIGN_ROOM", "CREATIVE_DIRECTION_ROOM", "REFERENCE_TRANSLATOR", "HUMAN_REVIEW"] },
    "issue_category": {
      "enum": [
        "DEPTH_COLLAPSE", "SUBJECT_PASTED", "WEAK_HIERARCHY", "GENERIC_AI_POLISH", "GENERIC_STOCK_FEEL", "VISUAL_CLUTTER", "WEAK_SUBJECT_SEPARATION", "LIGHTING_INTEGRATION_FAILURE", "ENVIRONMENTAL_STORYTELLING_FAILURE", "NEGATIVE_SPACE_FAILURE", "TYPOGRAPHY_COMPETITION", "COMPOSITIONAL_IMBALANCE", "WEAK_PREMIUM_PERCEPTION",
        "IDENTITY_LOSS", "TEXT_LOCK_LOSS", "COMPOSITION_LOSS", "DEPTH_LOSS", "REFERENCE_DILUTION", "REFERENCE_UNDERTRANSFER", "PROTECTED_FIELD_LOSS", "HARD_LOCK_LOSS", "CONTROLLED_VARIATION_VIOLATION", "SUBJECT_ENVIRONMENT_INTEGRATION_FAILURE", "OTHER"
      ]
    },
    "region": {
      "type": "object", "additionalProperties": false,
      "required": ["region_id", "label", "geometry"],
      "properties": {
        "region_id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "geometry": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "FULL_FRAME" } } },
            { "type": "object", "additionalProperties": false, "required": ["kind", "x", "y", "width", "height"], "properties": {
              "kind": { "const": "NORMALIZED_BOX" },
              "x": { "type": "number", "minimum": 0, "maximum": 1 },
              "y": { "type": "number", "minimum": 0, "maximum": 1 },
              "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
              "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
            } }
          ]
        }
      }
    },
    "violated_requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["source_artifact", "source_path", "statement"],
      "properties": {
        "source_artifact": { "enum": ["FINAL_FRAME_SPEC", "CREATIVE_DIRECTION_SPEC", "REFERENCE_TRANSFER_PLAN", "BRIEF_SPEC", "CRITIC_POLICY"] },
        "source_path": { "$ref": "#/$defs/json_pointer" },
        "requirement_id": { "$ref": "#/$defs/id" },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "field_protection": {
      "type": "object", "additionalProperties": false,
      "required": ["source_artifact", "field_path", "reason"],
      "properties": {
        "source_artifact": { "enum": ["FINAL_FRAME_SPEC", "CREATIVE_DIRECTION_SPEC", "REFERENCE_TRANSFER_PLAN", "BRIEF_SPEC", "GENERATION_RESULT"] },
        "field_path": { "$ref": "#/$defs/json_pointer" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "success_condition": {
      "type": "object", "additionalProperties": false,
      "required": ["observable_condition", "verification_method", "required_outcome"],
      "properties": {
        "observable_condition": { "type": "string", "minLength": 1 },
        "verification_method": { "enum": ["IMAGE_CRITIC_RECHECK", "SPEC_COMPLIANCE_RECHECK", "HUMAN_REVIEW", "REFERENCE_TRANSFER_RECHECK"] },
        "required_outcome": { "enum": ["PASS", "PASS_WITH_WARNINGS", "HUMAN_APPROVAL"] }
      }
    },
    "fix": {
      "type": "object", "additionalProperties": false,
      "required": ["fix_id", "issue_ref", "issue_category", "evidence_refs", "severity", "affected_region", "violated_requirement", "responsible_node", "return_depth", "protected_fields", "fields_that_must_not_change", "requested_change", "success_condition", "change_scope", "forbidden_changes"],
      "properties": {
        "fix_id": { "$ref": "#/$defs/id" },
        "issue_ref": { "$ref": "#/$defs/id" },
        "issue_category": { "$ref": "#/$defs/issue_category" },
        "evidence_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "severity": { "$ref": "#/$defs/severity" },
        "affected_region": { "$ref": "#/$defs/region" },
        "violated_requirement": { "$ref": "#/$defs/violated_requirement" },
        "responsible_node": { "$ref": "#/$defs/responsible_node" },
        "return_depth": { "$ref": "#/$defs/return_depth" },
        "protected_fields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/field_protection" } },
        "fields_that_must_not_change": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/json_pointer" } },
        "requested_change": { "type": "string", "minLength": 1 },
        "success_condition": { "$ref": "#/$defs/success_condition" },
        "change_scope": { "enum": ["TECHNICAL_EXECUTION", "COMPILER_MAPPING", "VISUAL_SYSTEM", "LAYOUT_TYPOGRAPHY", "CREATIVE_DIRECTION", "REFERENCE_TRANSFER"] },
        "forbidden_changes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "execution_constraints": {
      "type": "object", "additionalProperties": false,
      "required": ["regenerate_entire_pipeline", "preserve_unaffected_regions", "allow_new_objects", "allow_copy_change", "allow_identity_change", "notes"],
      "properties": {
        "regenerate_entire_pipeline": { "const": false },
        "preserve_unaffected_regions": { "const": true },
        "allow_new_objects": { "type": "boolean" },
        "allow_copy_change": { "type": "boolean" },
        "allow_identity_change": { "type": "boolean" },
        "notes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "validation_check": {
      "type": "object", "additionalProperties": false,
      "required": ["check_id", "target_fix_ids", "method", "pass_condition"],
      "properties": {
        "check_id": { "$ref": "#/$defs/id" },
        "target_fix_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "method": { "enum": ["IMAGE_CRITIC_RECHECK", "SPEC_COMPLIANCE_RECHECK", "HUMAN_REVIEW", "REFERENCE_TRANSFER_RECHECK", "SCHEMA_VALIDATION"] },
        "pass_condition": { "type": "string", "minLength": 1 }
      }
    },
    "validation_plan": {
      "type": "object", "additionalProperties": false,
      "required": ["checks", "require_no_regression_on_protected_fields", "failure_action"],
      "properties": {
        "checks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/validation_check" } },
        "require_no_regression_on_protected_fields": { "const": true },
        "failure_action": { "enum": ["REJECT_DELTA", "REQUEST_HUMAN_REVIEW", "CREATE_NARROWER_DELTA"] }
      }
    },
    "human_approval": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "evidence_refs"],
      "properties": {
        "status": { "enum": ["NOT_REQUIRED", "PENDING", "APPROVED", "REJECTED"] },
        "evidence_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "NOT_REQUIRED" } }, "required": ["status"] },
          "then": { "properties": { "evidence_refs": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "status": { "enum": ["APPROVED", "REJECTED"] } }, "required": ["status"] },
          "then": { "properties": { "evidence_refs": { "minItems": 1 } }, "required": ["rationale"] }
        }
      ]
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["producer", "producer_version", "created_at", "sources", "data_classification"],
      "properties": {
        "producer": { "const": "DELTA_FIX_PLANNER" },
        "producer_version": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "sources": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "data_classification": { "enum": ["REAL_PLAN", "SYNTHETIC_TEST_DATA"] },
        "notes": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "HUMAN_REVIEW_REQUIRED" } }, "required": ["status"] },
      "then": { "properties": { "human_approval": { "properties": { "status": { "const": "PENDING" } } } } }
    },
    {
      "if": { "properties": { "return_depth": { "const": "REFERENCE_TRANSLATOR" } }, "required": ["return_depth"] },
      "then": { "properties": { "responsible_nodes": { "contains": { "const": "REFERENCE_TRANSLATOR" } } } }
    },
    {
      "if": { "properties": { "return_depth": { "const": "CREATIVE_DIRECTION_ROOM" } }, "required": ["return_depth"] },
      "then": { "properties": { "responsible_nodes": { "contains": { "const": "CREATIVE_DIRECTION_ROOM" } } } }
    }
  ]
}